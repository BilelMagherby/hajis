# The blog API also reads the project root .env / .env.local, so ADMIN_EMAIL, ADMIN_PASSWORD
# and ADMIN_SESSION_SECRET are shared with the existing /api/admin/login function.
# Only put blog-specific overrides here (copy to backend/.env).

# SQLite by default; any SQLAlchemy URL works, e.g. postgresql+psycopg://user:pass@host/db
BLOG_DATABASE_URL=sqlite:///./data/blog.db
BLOG_UPLOAD_DIR=./data/uploads
BLOG_MAX_IMAGE_MB=10
BLOG_MAX_VIDEO_MB=80
# Comma-separated origins, only needed when the site is not served through the Vite / Vercel proxy.
BLOG_CORS_ORIGINS=
