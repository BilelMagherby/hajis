# Server-side only (read by the functions in /api, never bundled into the website).
# Locally: copy to .env.local. On Vercel: Project Settings -> Environment Variables.

# ---- Admin login -------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Long random string used to sign admin sessions (e.g. `openssl rand -hex 32`).
ADMIN_SESSION_SECRET=

# ---- Zoho Social (admin "مركز التواصل الاجتماعي") -----------------------------------------
# https://www.zoho.com/social/api/introduction.html
# Create a Self Client at https://api-console.zoho.com with the scopes
#   ZohoSocial.Organization.READ,ZohoSocial.Integration.READ,ZohoSocial.Publish.ALL,ZohoSocial.Media.ALL
# and exchange the generated code once for a refresh token at {ZOHO_ACCOUNTS_URL}/oauth/v2/token.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# These must match the data center where the Zoho account logs in. A token from another
# center is rejected. Saudi: https://accounts.zoho.sa and https://social.zoho.sa
# EU: .eu  India: .in  Australia: .com.au  Japan: .jp  Canada: accounts.zohocloud.ca / social.zohocloud.ca
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://social.zoho.com
ZOHO_PORTAL_ID=
ZOHO_BRAND_ID=
# Optional: Pinterest posts need a board; defaults to the brand's first board.
ZOHO_PINTEREST_BOARD_ID=

# ---- Blog ("مستجدات هاجس", functions in /api/blog) ----------------------------------------
# Postgres connection string, e.g. from Neon or Vercel Storage -> Postgres. The table is created
# automatically on first use. POSTGRES_URL is also accepted.
DATABASE_URL=
# Vercel Storage -> Blob: images/videos uploaded from the blog editor.
BLOB_READ_WRITE_TOKEN=
BLOG_MAX_IMAGE_MB=10
BLOG_MAX_VIDEO_MB=80
