# Server-side only (read by the functions in /api, never bundled into the website).
# Locally: copy to .env.local. On Vercel: Project Settings -> Environment Variables.

# ---- Admin login -------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Long random string used to sign admin sessions (e.g. `openssl rand -hex 32`).
ADMIN_SESSION_SECRET=

# ---- Zoho Social (admin "مركز التواصل الاجتماعي") -----------------------------------------
# https://www.zoho.com/social/api/introduction.html
# Create a Self Client at https://api-console.zoho.com with the scopes
#   ZohoSocial.Organization.READ,ZohoSocial.Integration.READ,ZohoSocial.Publish.ALL,ZohoSocial.Media.ALL
# and exchange the generated code once for a refresh token at {ZOHO_ACCOUNTS_URL}/oauth/v2/token.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Only change these two if the Zoho account is in another data center (.eu, .in, .com.au ...).
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://social.zoho.com
ZOHO_PORTAL_ID=
ZOHO_BRAND_ID=
# Optional: Pinterest posts need a board; defaults to the brand's first board.
ZOHO_PINTEREST_BOARD_ID=
